{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@cardinal4/opencode-git-plugin",
  "version": "0.3.1",
  "description": "OpenCode v2 TUI sidebar plugin listing git working-copy changes with diff preview",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.6",
    "@opencode/theme": "^2.2.6"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "solid-js": "1.9.12",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "git",
    "vcs"
  ],
  "license": "MIT",
  "author": "Aktug Urun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cardin/opencode-git-plugin.git"
  },
  "homepage": "https://github.com/cardin/opencode-git-plugin#readme",
  "bugs": {
    "url": "https://github.com/cardin/opencode-git-plugin/issues"
  },
  "engines": {
    "opencode": ">=2.0.0 <3"
  },
  "publishConfig": {
    "access": "public"
  }
}
